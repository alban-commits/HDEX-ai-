{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:design": "HF_DESIGN_INSPECTOR=1 vite dev --mode design",
    "build": "node scripts/validate.mjs && tsr generate && tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "start": "node scripts/start-node.mjs",
    "start:df-deploy": "node scripts/start-node.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "preview": "node scripts/start-node.mjs",
    "postinstall": "node scripts/verify-install.mjs",
    "check:adapted": "node scripts/check-adaptation.mjs",
    "test": "bun test tests/*.test.ts && node --test tests/app.test.mjs",
    "validate": "node scripts/validate.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@higgsfield/fnf": "workspace:*",
    "@higgsfield/fnf-react": "workspace:*",
    "@higgsfield/quanta": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "@base-ui/react": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "^1.167.18",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "nitro": "3.0.260429-beta",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "overrides": {
    "@types/react": "19.2.15"
  }
}
