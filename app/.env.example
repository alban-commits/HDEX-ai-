# 공개 HTTPS origin. OAuth callback과 CSRF 검증에 사용하는 고정값입니다.
HDEX_PUBLIC_ORIGIN=https://influencer-frame.example.com

# 32 random bytes를 base64url(패딩 없음)로 인코딩한 43자 값입니다.
# 예: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
HDEX_HIGGSFIELD_OAUTH_COOKIE_SECRET=replace_with_43_character_base64url_secret

# 기본값은 https://mcp.higgsfield.ai/mcp 입니다.
HDEX_HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# 회사 공용 서버 비밀입니다. 브라우저나 Git에 넣지 않습니다.
OPENAI_API_KEY=replace_in_df_deploy_secret_environment

# 운영 서버는 사내망 reverse proxy만 Node loopback에 접근하도록 구성합니다.
HOST=127.0.0.1
PORT=3000

# Windows 절대 경로만 허용하며 앱 소유 하위 폴더만 정리합니다.
HDEX_TEMP_DIR=C:\\HDEX\\temp
HDEX_TEMP_TTL_SECONDS=86400

# 실제 유료 생성은 운영 검수 후 명시적으로 true로 바꾸기 전까지 차단합니다.
HDEX_GENERATION_ENABLED=false
